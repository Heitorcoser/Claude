{
  "name": "losters-perdido",
  "productName": "Perdido",
  "version": "1.0.17",
  "description": "PERDIDO — um jogo inspirado em Undertale e Deltarune",
  "author": "Heitorcoser",
  "main": "main.js",
  "perdido": { "versionCode": 17 },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.heitorcoser.perdido",
    "productName": "Perdido",
    "files": ["main.js", "icon.png", "package.json", "www/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "artifactName": "Perdido-Setup.exe",
      "shortcutName": "Perdido"
    }
  }
}
